<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title><%= title || "Downtown Donuts" %></title>

  <!-- Google fonts -->
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand">
        <!-- Use a real logo image if you have one; fallback text shown -->
        <img src="/img/logo.png" alt="Downtown Donuts logo" class="logo" onerror="this.style.display='none'">
        <span class="brand-text">Downtown Donuts</span>
      </a>

      <nav class="main-nav">
        <a href="/">Home</a>
        <a href="/menu">Menu</a>
        <a href="/about">About</a>
        <a href="/comments">Comments</a>
      </nav>
    </div>
  </header>

  <main class="container site-main">
    <%- body %>
  </main>

  <footer class="site-footer">
    <div class="container">
      <small>© <%= new Date().getFullYear() %> Downtown Donuts — Serving downtown since 1992</small>
    </div>
  </footer>

</body>
</html>
